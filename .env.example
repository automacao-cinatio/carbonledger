# Copie para .env (make up faz isso sozinho). Nenhum valor abaixo e real.
# Os nomes de host (postgres, redis, minio...) valem dentro do docker compose.

# Aplicacao
AMBIENTE=desenvolvimento
LOG_NIVEL=INFO

# PostgreSQL 16
POSTGRES_DB=carbonledger
POSTGRES_USER=carbonledger
POSTGRES_PASSWORD=troque-me-postgres
DATABASE_URL=postgresql://carbonledger:troque-me-postgres@postgres:5432/carbonledger

# Redis
REDIS_URL=redis://redis:6379/0

# S3 (MinIO com Object Lock em desenvolvimento)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=carbonledger-dev
S3_SECRET_KEY=troque-me-minio-123
S3_BUCKET_EVIDENCIAS=evidencias

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# E-mail (Mailpit em desenvolvimento; Resend em producao)
SMTP_HOST=mailpit
SMTP_PORT=1025
RESEND_API_KEY=

# IA: o modelo vem sempre da variavel de ambiente, nunca do codigo
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=

# Integracoes (preenchidas nos prompts P04, P21 e P22)
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
